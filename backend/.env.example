# MediMate AI Backend Environment Configuration

# Server Port (Default: 5001 to avoid conflict with macOS AirPlay on port 5000)
PORT=5001

# Google AI Studio Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Gemini Model Identifier (Free Tier: gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated local development origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5001,http://127.0.0.1:5001,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
